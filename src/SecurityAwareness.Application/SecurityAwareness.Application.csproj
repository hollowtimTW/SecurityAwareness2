<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecurityAwareness.Application</RootNamespace>
    <AssemblyName>SecurityAwareness.Application</AssemblyName>
  </PropertyGroup>

  <!-- Suppress analyzer warnings that don't apply to typical service code -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1822;CA1305;CA1861;NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecurityAwareness.Common\SecurityAwareness.Common.csproj" />
    <ProjectReference Include="..\SecurityAwareness.Infrastructure\SecurityAwareness.Infrastructure.csproj" />
  </ItemGroup>

</Project>
