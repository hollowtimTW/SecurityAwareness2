@model SecurityAwareness.Platform.ViewModels.EmailDeliveryPageViewModel
@{ ViewData["Title"] = "寄信紀錄"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📧 寄信紀錄</h2>
    <span class="badge bg-secondary">總計 @Model.TotalCount 筆</span>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">活動</label>
            <select name="campaignId" class="form-select">
                <option value="">全部活動</option>
                @foreach (var c in Model.Campaigns)
                {
                    <option value="@c.CampaignId" @(Model.CampaignId == c.CampaignId ? "selected" : "")>@c.Code — @c.Title</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">寄件匣</label>
            <select name="mailboxId" class="form-select">
                <option value="">全部寄件匣</option>
                @foreach (var m in Model.Mailboxes)
                {
                    <option value="@m.SenderMailboxId" @(Model.MailboxId == m.SenderMailboxId ? "selected" : "")>@m.Email</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">狀態</label>
            <select name="status" class="form-select">
                <option value="">全部狀態</option>
                @foreach (var s in Model.StatusOptions)
                {
                    <option value="@s.Value" @(Model.Status == s.Value ? "selected" : "")>@s.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">🔍 篩選</button>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">目前沒有符合條件的寄信紀錄。</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>時間 (UTC)</th>
                        <th>主旨</th>
                        <th>收件人</th>
                        <th>活動</th>
                        <th>寄件匣</th>
                        <th>狀態</th>
                        <th>嘗試</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        var badgeClass = r.Status switch
                        {
                            "Success" => "bg-success",
                            "Failed" => "bg-danger",
                            "Retry" => "bg-warning text-dark",
                            "Pending" => "bg-secondary",
                            _ => "bg-light text-dark"
                        };
                        <tr>
                            <td><small class="text-muted">@r.CreatedAt.ToString("MM-dd HH:mm:ss")</small></td>
                            <td><span title="@r.Subject">@(r.Subject.Length > 50 ? r.Subject[..50] + "..." : r.Subject)</span></td>
                            <td>
                                <strong>@r.ToDisplayName</strong><br/>
                                <small class="text-muted">@r.ToEmail</small>
                            </td>
                            <td><code>@r.CampaignCode</code></td>
                            <td><small>@r.SenderMailboxEmail</small></td>
                            <td><span class="badge @badgeClass">@r.Status</span></td>
                            <td>@r.AttemptCount</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = r.LogId })">詳情</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { campaignId = Model.CampaignId, status = Model.Status, mailboxId = Model.MailboxId, page = Model.Page - 1 })">«</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { campaignId = Model.CampaignId, status = Model.Status, mailboxId = Model.MailboxId, page = p })">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { campaignId = Model.CampaignId, status = Model.Status, mailboxId = Model.MailboxId, page = Model.Page + 1 })">»</a>
                </li>
            </ul>
        </nav>
    }
}
