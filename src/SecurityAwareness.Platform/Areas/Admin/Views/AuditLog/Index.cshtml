@model SecurityAwareness.Platform.ViewModels.AuditLogPageViewModel
@{ ViewData["Title"] = "稽核紀錄";
    string ActionLink(int page)
    {
        var qs = new Dictionary<string, string?>();
        if (!string.IsNullOrEmpty(Model.FilterEntityType)) qs["entityType"] = Model.FilterEntityType;
        if (!string.IsNullOrEmpty(Model.FilterAction)) qs["actionName"] = Model.FilterAction;
        if (!string.IsNullOrEmpty(Model.FilterActorKey)) qs["actorKey"] = Model.FilterActorKey;
        if (Model.FilterFromUtc.HasValue) qs["fromUtc"] = Model.FilterFromUtc.Value.ToString("o");
        if (Model.FilterToUtc.HasValue) qs["toUtc"] = Model.FilterToUtc.Value.ToString("o");
        if (page > 1) qs["page"] = page.ToString();
        return Url.Action("Index", qs)!;
    }
}
<h2>📋 Audit Log</h2>
<p class="text-muted">共 <strong>@Model.TotalCount</strong> 筆,第 @(Model.Page) / @Model.TotalPages 頁</p>

<div class="card mb-3"><div class="card-body">
<form method="get" class="row g-2 align-items-end">
    <div class="col-md-3"><label class="form-label small">EntityType</label>
        <input class="form-control form-control-sm" name="entityType" value="@Model.FilterEntityType" placeholder="Campaign" /></div>
    <div class="col-md-2"><label class="form-label small">Action</label>
        <input class="form-control form-control-sm" name="actionName" value="@Model.FilterAction" placeholder="Dispatch" /></div>
    <div class="col-md-3"><label class="form-label small">Actor</label>
        <input class="form-control form-control-sm" name="actorKey" value="@Model.FilterActorKey" /></div>
    <div class="col-md-2"><label class="form-label small">From</label>
        <input class="form-control form-control-sm" type="datetime-local" name="fromUtc" value="@Model.FilterFromUtc?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" /></div>
    <div class="col-md-2"><label class="form-label small">To</label>
        <input class="form-control form-control-sm" type="datetime-local" name="toUtc" value="@Model.FilterToUtc?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" /></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-primary btn-sm">🔍 篩選</button>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index")">清除</a></div>
</form>
</div></div>

<div class="card"><table class="table table-sm table-striped table-hover mb-0">
<thead class="table-light"><tr><th>ID</th><th>時間</th><th>Action</th><th>Entity</th><th>Actor</th><th>Detail</th><th></th></tr></thead>
<tbody>
@foreach (var a in Model.Items)
{
    <tr>
        <td><code>@a.AuditLogId</code></td>
        <td class="small">@a.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
        <td><span class="badge bg-secondary">@a.Action</span></td>
        <td>@a.EntityType <code>@a.EntityId</code></td>
        <td>@a.ActorKey</td>
        <td class="small text-truncate" style="max-width: 350px;">@(a.DetailJson ?? "—")</td>
        <td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", new { id = a.AuditLogId })">詳情</a></td>
    </tr>
}
@if (Model.Items.Count == 0)
{
    <tr><td colspan="7" class="text-center text-muted py-3">沒有資料</td></tr>
}
</tbody></table></div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
        <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@ActionLink(Model.Page - 1)">«</a></li>
        @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@ActionLink(p)">@p</a></li>
        }
        <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@ActionLink(Model.Page + 1)">»</a></li>
    </ul></nav>
}
