@model SecurityAwareness.Platform.ViewModels.ReportDashboardViewModel
@{ ViewData["Title"] = "報表"; }
<h2>📊 演練報表</h2>

@if (Model.TotalAssigned == 0)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}
else
{
    <p>活動:<strong>@Model.CampaignCode</strong> — @Model.CampaignTitle</p>
    <form method="get" class="mb-3">
        <label>切換活動:</label>
        <select name="campaignId" class="form-select d-inline w-auto" onchange="this.form.submit()">
            @foreach (var c in (IReadOnlyList<SecurityAwareness.Infrastructure.Entities.PhishingCampaign>)ViewBag.AllCampaigns)
            {
                <option value="@c.CampaignId" selected="@(c.CampaignId == Model.CampaignId)">
                    @c.Code — @c.Title
                </option>
            }
        </select>
    </form>

    <div class="row g-2 mb-4">
        <div class="col-md-3"><div class="card p-3 text-center"><div class="display-6">@Model.TotalAssigned</div><small class="text-muted">指派數</small></div></div>
        <div class="col-md-3"><div class="card p-3 text-center bg-warning-subtle"><div class="display-6">@Model.ClickedCount</div><small class="text-muted">點擊人數</small></div></div>
        <div class="col-md-3"><div class="card p-3 text-center bg-success-subtle"><div class="display-6">@Model.ReportedCount</div><small class="text-muted">回報人數</small></div></div>
        <div class="col-md-3"><div class="card p-3 text-center bg-info-subtle"><div class="display-6">@Model.ClickRate.ToString("F1")%</div><small class="text-muted">點擊率</small></div></div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card p-3">
                <h5>部門風險排名</h5>
                <table class="table table-sm mb-0">
                    <thead><tr><th>部門</th><th class="text-end">指派</th><th class="text-end">點擊</th><th class="text-end">點擊率</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Departments)
                        {
                            <tr>
                                <td>@d.Code — @d.Name</td>
                                <td class="text-end">@d.TotalAssigned</td>
                                <td class="text-end">@d.ClickedCount</td>
                                <td class="text-end">
                                    @if (d.ClickRate >= 50) { <span class="badge bg-danger">@d.ClickRate.ToString("F1")%</span> }
                                    else if (d.ClickRate >= 20) { <span class="badge bg-warning">@d.ClickRate.ToString("F1")%</span> }
                                    else { <span class="badge bg-success">@d.ClickRate.ToString("F1")%</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3">
                <h5>點擊熱門時段</h5>
                <table class="table table-sm mb-0">
                    <thead><tr><th>時段</th><th class="text-end">點擊數</th></tr></thead>
                    <tbody>
                        @foreach (var h in Model.HourlyClicks)
                        {
                            <tr>
                                <td>@h.HourOfDay:00 — @(h.HourOfDay + 1):00</td>
                                <td class="text-end">@h.ClickCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
