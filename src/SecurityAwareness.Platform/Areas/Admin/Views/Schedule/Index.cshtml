@model IReadOnlyList<SecurityAwareness.Platform.ViewModels.ScheduleListItemViewModel>
@{
    ViewData["Title"] = "排程";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>⏰ 活動排程</h2>
    <a class="btn btn-primary" href="@Url.Action("Create")">+ 新增排程</a>
</div>
<p class="text-muted small">CampaignSchedulerService 每分鐘掃描,時間到自動觸發派發。</p>

<div class="card">
    <table class="table table-sm table-striped mb-0">
        <thead class="table-light">
            <tr><th>ID</th><th>活動</th><th>類型</th><th>首次執行</th><th>週期性結束</th><th>下次執行</th><th>上次執行</th><th>啟用</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.ScheduleId</td>
                    <td>@s.CampaignCode</td>
                    <td>
                        @switch (s.ScheduleType)
                        {
                            case 1: <span class="badge bg-secondary">OneTime</span> break;
                            case 2: <span class="badge bg-info">Daily</span> break;
                            case 3: <span class="badge bg-warning">Weekly</span> break;
                        }
                    </td>
                    <td class="small">@s.StartAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="small">@(s.EndAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="small">@(s.NextRunAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="small">@(s.LastRunAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td>@(s.IsActive ? "✅" : "❌")</td>
                    <td>
                        <form method="post" action="@Url.Action("ToggleActive", new { id = s.ScheduleId })" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-@(s.IsActive ? "warning" : "success")">@(s.IsActive ? "停用" : "啟用")</button>
                        </form>
                        <form method="post" action="@Url.Action("Delete", new { id = s.ScheduleId })" class="d-inline"
                              onsubmit="return confirm('確定刪除?');">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-3">尚未建立任何排程</td></tr>
            }
        </tbody>
    </table>
</div>
