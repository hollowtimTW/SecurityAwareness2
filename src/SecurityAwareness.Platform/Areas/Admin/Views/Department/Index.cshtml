@model IReadOnlyList<SecurityAwareness.Platform.ViewModels.DepartmentListItemViewModel>
@{ ViewData["Title"] = "部門"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🏢 部門</h2>
    <a class="btn btn-primary" href="@Url.Action("Create")">+ 新增部門</a>
</div>
<div class="card">
    <table class="table table-sm table-striped mb-0">
        <thead class="table-light">
            <tr><th>Code</th><th>名稱</th><th>啟用</th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr><td><code>@d.Code</code></td><td>@d.Name</td><td>@(d.IsActive ? "✅" : "❌")</td></tr>
            }
        </tbody>
    </table>
</div>
