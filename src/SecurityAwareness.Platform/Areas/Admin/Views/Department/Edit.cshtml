@model SecurityAwareness.Platform.ViewModels.DepartmentEditViewModel
@{ ViewData["Title"] = "編輯部門"; }
<h2>🏢 編輯部門 #@Model.DepartmentId</h2>
<form method="post" class="card card-body" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="DepartmentId" value="@Model.DepartmentId" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">代碼 *</label>
            <input class="form-control" name="Code" value="@Model.Code" required />
        </div>
        <div class="col-md-8">
            <label class="form-label">名稱 *</label>
            <input class="form-control" name="Name" value="@Model.Name" required />
        </div>
        <div class="col-12">
            <label class="form-label">部門主管 (選填)</label>
            <select class="form-select" name="ManagerEmployeeId">
                <option value="">— 不指定 —</option>
                @foreach (var m in Model.Managers)
                {
                    <option value="@m.EmployeeId" @(Model.ManagerEmployeeId == m.EmployeeId ? "selected" : "")>
                        @m.EmployeeNo — @m.DisplayName
                    </option>
                }
            </select>
        </div>
        <div class="col-12 form-check ms-3">
            <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" />
            <label class="form-check-label">啟用</label>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary">儲存</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">取消</a>
    </div>
</form>
