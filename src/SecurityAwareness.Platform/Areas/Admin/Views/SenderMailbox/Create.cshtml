@model SecurityAwareness.Platform.ViewModels.MailboxEditViewModel
@{ ViewData["Title"] = "新增信箱"; }
<h2>📧 新增寄件信箱</h2>
<form method="post" class="card card-body" style="max-width: 640px;">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-7">
            <label class="form-label">Email *</label>
            <input class="form-control" name="Email" type="email" required placeholder="awareness@egit.com.tw" />
        </div>
        <div class="col-md-5">
            <label class="form-label">顯示名稱 *</label>
            <input class="form-control" name="DisplayName" required placeholder="資訊部 系統組" />
        </div>
        <div class="col-md-6">
            <label class="form-label">寄件類型</label>
            <select class="form-select" name="Provider">
                <option value="0">Fake (寫 .eml 到本機)</option>
                <option value="1">Graph (M365)</option>
                <option value="2">SMTP</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">每日配額</label>
            <input class="form-control" name="DailyQuota" type="number" value="500" />
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary">建立</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">取消</a>
    </div>
</form>
