@model SecurityAwareness.Platform.ViewModels.CampaignAssignmentsViewModel
@{ ViewData["Title"] = "受測者清單"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📋 @Model.CampaignCode — 受測者清單</h2>
    <div>
        <a class="btn btn-outline-secondary btn-sm" href="@ViewBag.TrackingUrl">📄 匯出追蹤連結</a>
        <a class="btn btn-outline-secondary btn-sm" href="@ViewBag.ReportUrl">📊 匯出完整報表</a>
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">← 返回</a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3"><div class="card p-3"><strong>@Model.TotalAssigned</strong><br /><small>指派數</small></div></div>
    <div class="col-md-3"><div class="card p-3 bg-warning-subtle"><strong>@Model.TotalClicked</strong><br /><small>點擊人數</small></div></div>
    <div class="col-md-3"><div class="card p-3 bg-success-subtle"><strong>@Model.TotalReported</strong><br /><small>回報人數</small></div></div>
</div>

<div class="card">
    <table class="table table-sm mb-0">
        <thead class="table-light">
            <tr><th>員工</th><th>Email</th><th>狀態</th><th class="text-end">點擊次數</th><th>寄出</th><th>首次點擊</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.EmployeeNo <br /><small class="text-muted">@r.DisplayName</small></td>
                    <td>@r.Email</td>
                    <td><span class="badge bg-secondary">@r.Status</span></td>
                    <td class="text-end">@r.ClickCount</td>
                    <td class="small">@(r.DispatchedAt?.ToString("MM-dd HH:mm") ?? "-")</td>
                    <td class="small">@(r.FirstClickedAt?.ToString("MM-dd HH:mm") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
