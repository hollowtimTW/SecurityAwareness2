@model IReadOnlyList<SecurityAwareness.Platform.ViewModels.EmployeeListItemViewModel>
@{ ViewData["Title"] = "員工"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>👥 員工清單</h2>
    <a class="btn btn-primary" href="@Url.Action("Create")">+ 新增員工</a>
</div>
<div class="card">
    <table class="table table-sm table-striped mb-0">
        <thead class="table-light">
            <tr><th>員工編號</th><th>Email</th><th>姓名</th><th>部門</th><th>在職</th><th>建立</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td><code>@e.EmployeeNo</code></td>
                    <td>@e.Email</td>
                    <td>@e.DisplayName</td>
                    <td>@e.DepartmentName</td>
                    <td>@(e.IsActive ? "✅" : "❌")</td>
                    <td class="small">@e.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-3">尚無員工</td></tr>
            }
        </tbody>
    </table>
</div>
