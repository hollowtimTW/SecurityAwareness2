<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Security Awareness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <header class="border-bottom mb-3">
        <nav class="navbar navbar-expand bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">🛡 Security Awareness</a>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-nav me-auto">
                        <a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Dashboard</a>
                        <a class="nav-link" href="@Url.Action("Index", "Campaign", new { area = "Admin" })">活動</a>
                        <a class="nav-link" href="@Url.Action("Index", "Department", new { area = "Admin" })">部門</a>
                        <a class="nav-link" href="@Url.Action("Index", "Employee", new { area = "Admin" })">員工</a>
                        <a class="nav-link" href="@Url.Action("Index", "SenderMailbox", new { area = "Admin" })">寄件信箱</a>
                        <a class="nav-link" href="@Url.Action("Index", "Import", new { area = "Admin" })">匯入</a>
                        <a class="nav-link" href="@Url.Action("Index", "Report", new { area = "Admin" })">報表</a>
                        <a class="nav-link" href="@Url.Action("Index", "AuditLog", new { area = "Admin" })">稽核</a>
                    </div>
                    <span class="navbar-text me-3">@User.Identity!.Name</span>
                    <form method="post" action="/Account/Logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">登出</button>
                    </form>
                }
            </div>
        </nav>
    </header>
    <main class="container-fluid">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>
    <footer class="text-center text-muted py-3 mt-4 border-top">
        <small>Security Awareness Platform v1.0</small>
    </footer>
</body>
</html>
