<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SecurityAwareness.Tests</RootNamespace>
    <AssemblyName>SecurityAwareness.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1305;CA1861;CA1826;CA1827;CA1707;NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecurityAwareness.Common\SecurityAwareness.Common.csproj" />
    <ProjectReference Include="..\..\src\SecurityAwareness.Infrastructure\SecurityAwareness.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SecurityAwareness.Application\SecurityAwareness.Application.csproj" />
  </ItemGroup>

</Project>
